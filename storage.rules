rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Archived statements path:
    // Only backend Firebase Admin SDK (with Service Account) can write.
    // Read is secured for authenticated admins/users.
    match /archived_statements/{yearMonth}/{entityName}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false; // Only Admin SDK bypasses this rule
    }

    // Default rule for all other storage paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
